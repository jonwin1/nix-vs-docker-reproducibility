FROM golang:1.26-alpine

RUN apk add --no-cache bash git ca-certificates

WORKDIR /src

COPY raftly/ /src/raftly

WORKDIR /src/raftly

# Download the Go dependencies.
RUN go mod download

# Add the runner script from this test repository.
COPY scripts/scenarios.sh /src/scripts/scenarios.sh

RUN chmod +x /src/scripts/scenarios.sh

ENV RESULTS_DIR=/results

ENTRYPOINT ["/src/scripts/scenarios.sh"]
